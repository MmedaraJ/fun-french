{
  "name": "fun-french",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:pages": "npm run prepare-assets && tsc -p . && BASE_PATH=/fun-french/ vite build --outDir docs --emptyOutDir && node -e \"require('fs').writeFileSync('docs/.nojekyll', '')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.7.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@twemoji/svg": "^15.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "emojilib": "^4.0.3",
    "english-verbs-helper": "^3.4.0",
    "english-verbs-irregular": "^3.4.0",
    "fake-indexeddb": "^6.2.6",
    "french-verbs": "^5.4.0",
    "french-verbs-lefff": "^3.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
